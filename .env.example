# Copy to .env and set values for this terminal. Existing process environment wins.
PORTHOLE_TERMINAL_ID=axsprint-rasp-01

# Live detection upload: SSH unless PORTHOLE_API_URL is set.
PORTHOLE_UPLOAD_HOST=
PORTHOLE_UPLOAD_USER=
PORTHOLE_UPLOAD_DIR=
PORTHOLE_UPLOAD_KEY=
PORTHOLE_UPLOAD_BW_KIB=24576

# Optional HTTP API upload instead of SSH for live JPG/JSON pairs.
PORTHOLE_API_URL=
PORTHOLE_API_TOKEN=

# Optional upload of completed session folders over SSH/rsync.
PORTHOLE_RAW_UPLOAD=false
PORTHOLE_RAW_DIR=
